# ── BoonesBot — omgevingsvariabelen ─────────────────────────────────────────────
# Kopieer dit bestand naar .env en vul de waarden in:
#   cp .env.example .env
# Commit .env NOOIT naar Git (staat al in .gitignore)
# ──────────────────────────────────────────────────────────────────────────────

# Verplicht: Telegram Bot Token (via @BotFather op Telegram)
TELEGRAM_BOT_TOKEN=jouw_token_hier

# Aanbevolen: alleen deze Telegram-gebruikers mogen de bot gebruiken (komma-gescheiden).
# Stuur /id naar de bot om je eigen ID te zien. Leeg laten = iedereen mag de bot gebruiken.
ALLOWED_USER_IDS=
